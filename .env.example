# Server-side only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Set the same variables in Vercel → Project → Settings → Environment Variables.

# Key accepted by the payments service (bf-back-v2) API_KEYS list. Required.
# The service owns WayForPay, the order records and Nova Poshta (city/branch
# lookups, waybills); this app holds no other secret. Nova Poshta and studio
# WayForPay keys belong in the service's env, never here.
PAYMENT_SERVICE_API_KEY=

# Payments service API base. Optional — defaults to the production service.
# PAYMENT_SERVICE_URL=https://bf-club-delta.vercel.app/api/v1
